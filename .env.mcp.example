# Copy this file to .env.mcp before launching docker-compose.mcp.yml.

# Required. Use a long random value.
MCP_AUTH_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN

# Consumers install the validated shared cache release and do not need an
# EcoTaxa account. Use a read-only GitHub token only for a private release.
ECOTAXA_CACHE_MODE=consumer
ECOTAXA_CACHE_RELEASE_REPOSITORY=TidianeCisse777/IDEA
ECOTAXA_CACHE_RELEASE_TAG=ecotaxa-cache-current
ECOTAXA_CACHE_RELEASE_TOKEN=

# Publisher-only credentials, used to refresh and release a new cache.
ECOTAXA_USERNAME=
ECOTAXA_PASSWORD=

# Optional sync controls.
ECOTAXA_NIGHTLY_SYNC=true
ECOTAXA_SYNC_HOUR=3
