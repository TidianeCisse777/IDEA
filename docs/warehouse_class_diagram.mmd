classDiagram
direction LR

class dataset_version {
  +bigint id PK
  +text source_instance
  +text dataset_key
  +text version_key
  +text file_manifest_uri
  +text sha256
}

class ecotaxa_project {
  +bigint project_id PK
  +bigint dataset_version_id FK
  +text title
  +text instrument
  +text source_instance
}
class ecotaxa_sample {
  +bigint id PK
  +bigint dataset_version_id FK
  +bigint project_id logical_ref
  +text sample_id
