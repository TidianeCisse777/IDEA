# Variables du warehouse NeoLab. Copier vers .env.warehouse (ignoré par Git) et
# remplacer chaque valeur CHANGER_MOI. Ne jamais commiter de vrai mot de passe.
# Guide complet: docs/WAREHOUSE_README.md

# --- Serveur PostgreSQL (docker-compose.warehouse.yml et scripts d'administration)
WAREHOUSE_POSTGRES_DB=neolab_warehouse
WAREHOUSE_POSTGRES_USER=neolab
WAREHOUSE_POSTGRES_PASSWORD=CHANGER_MOI
WAREHOUSE_POSTGRES_HOST=127.0.0.1
WAREHOUSE_POSTGRES_PORT=55432

# --- Rôles de lecture créés au déploiement (chacun son mot de passe)
WAREHOUSE_READER_PASSWORD=CHANGER_MOI
WAREHOUSE_NAVIGATOR_PASSWORD=CHANGER_MOI

# --- Interface de navigation
WAREHOUSE_NAVIGATOR_PORT=8090

# --- Adresse d'écoute des ports publiés (base et navigateur). 127.0.0.1 = cette machine seulement.
#     Pour un accès distant, préférer un tunnel SSH; sinon 0.0.0.0 avec TLS (docs/WAREHOUSE_CONNECT.md).
WAREHOUSE_BIND_ADDRESS=127.0.0.1

# --- Adresse que les utilisateurs mettent dans leur fichier d'identifiants
#     (défaut: WAREHOUSE_POSTGRES_HOST; ne pas exposer le port sur Internet)
# WAREHOUSE_PUBLIC_HOST=warehouse.exemple.org
# WAREHOUSE_PUBLIC_PORT=55432

# --- Chargement des sources (scripts/load_warehouse.py). À renseigner seulement sur la machine qui charge.
# ECOTAXA_USERNAME=CHANGER_MOI
# ECOTAXA_PASSWORD=CHANGER_MOI
# ECOPART_TOKEN=            # facultatif, sinon le compte EcoTaxa est utilisé pour EcoPart
